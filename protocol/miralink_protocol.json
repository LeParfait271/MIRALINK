        "type": "input",
        "payloadBytes": 63,
        "wireBytes": 64,
        "purpose": "native controller state"
      },
      "0x02": {
        "type": "output",
        "payloadBytes": 47,
        "descriptorWireBytes": 48,
        "acceptedWireBytes": [48, 63],
        "purpose": "bounded controller output body; compact HIDAPI and Linux forms"
      },
      "0x05": {
        "type": "feature",
        "payloadBytes": 40,
        "wireBytes": 41,
        "purpose": "synthetic nominal-scale motion-calibration fallback"
      },
      "0x09": {
        "type": "feature",
        "payloadBytes": 19,
        "wireBytes": 20,
        "purpose": "local/unicast bridge identifier; never the controller Bluetooth address"
      },
      "0x20": {
        "type": "feature",
        "payloadBytes": 63,
        "wireBytes": 64,
        "purpose": "MiraLink-marked persona revision"
      },
      "0x70": {
        "type": "feature",
        "payloadBytes": 64,
        "wireBytes": 65,
        "purpose": "MiraLink command frame"
      },
      "0x71": {
        "type": "feature",
        "payloadBytes": 64,
        "wireBytes": 65,
        "purpose": "MiraLink response frame",
        "readSemantics": "stable until the next MiraLink command report produces a success or error response"
      },
      "0x72": {
        "type": "reserved",
        "exposed": false,
        "emitted": false,
        "purpose": "reserved for a future non-Sony transport"
      }
    }
  },
